<!-- GURU CONTENT -->
<div class="guru-content">
  <%- include('./data-siswa') %> <%- include('./nilai-table') %>

  <div class="catatan-perkembangan-section">
    <h3>CATATAN PERKEMBANGAN</h3>
    <% if (catatan_perkembangan && catatan_perkembangan.length > 0) { %>
    <div class="catatan-list">
      <% catatan_perkembangan.forEach((catatan) => { %>
      <div class="catatan-item">
        <div class="catatan-date">
          <%= new Date(catatan.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long',
          year: 'numeric' }) %>
        </div>
        <div class="catatan-content">
          <p><strong><%= catatan.judul %></strong></p>
          <p><%= catatan.deskripsi %></p>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <p style="text-align: center; color: #999">Tidak ada catatan perkembangan</p>
    <% } %>
  </div>

  <% if (catatan_wali_kelas && catatan_wali_kelas.length > 0) { %>
  <div class="catatan-wali-kelas-section">
    <h3>CATATAN WALI KELAS</h3>
    <div class="catatan-list">
      <% catatan_wali_kelas.forEach((catatan) => { %>
      <div class="catatan-item">
        <div class="catatan-date">
          <%= new Date(catatan.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long',
          year: 'numeric' }) %>
        </div>
        <div class="catatan-content">
          <p><strong><%= catatan.judul %></strong></p>
          <p><%= catatan.deskripsi %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %> <%- include('./attendance-summary') %>
</div>
